# =============================================================================
#  PollDeck – Konfiguration
#  Kopieren:  cp .env.example .env   und danach die Werte anpassen.
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
# Öffentliche Domain (ohne https://). Wird im Beitritts-Banner und für Links genutzt.
APP_DOMAIN=poll.nebendahl.eu
# Vollständige öffentliche URL (optional, Standard: https://APP_DOMAIN)
# APP_URL=https://poll.nebendahl.eu
# Name der Instanz (im Admin-Bereich später änderbar)
APP_NAME=PollDeck
# Standardsprache der Oberfläche: de oder en (im Admin-Bereich änderbar)
DEFAULT_LOCALE=de

# --- Sicherheit --------------------------------------------------------------
# Langes, zufälliges Geheimnis (mind. 32 Zeichen), z. B.:  openssl rand -base64 48
SESSION_SECRET=bitte-durch-ein-langes-zufaelliges-geheimnis-ersetzen
# Cookies nur über HTTPS senden. Nur für lokale Tests ohne TLS auf false setzen.
COOKIE_SECURE=true
# Anzahl vertrauenswürdiger Proxys vor der API (Caddy + Nginx im web-Container = 2).
# Damit wird die echte Client-IP aus X-Forwarded-For übernommen.
TRUST_PROXY=2

# --- Registrierung -------------------------------------------------------------
# open = jeder darf sich registrieren, invite = nur mit Einladung, closed = gar nicht
# Der erste registrierte Benutzer wird immer Admin. (Im Admin-Bereich änderbar.)
REGISTRATION_MODE=open

# --- Uploads -----------------------------------------------------------------
# Maximale Größe von Bild-Uploads in MB (im Admin-Bereich änderbar)
MAX_UPLOAD_MB=10

# --- Datenbank (PostgreSQL) --------------------------------------------------
POSTGRES_USER=polldeck
# Unbedingt ändern:  openssl rand -hex 24
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=polldeck

# --- E-Mail (SMTP) – für Passwort-Reset und Einladungen ------------------------
# SMTP_HOST leer lassen, um den Mailversand zu deaktivieren.
SMTP_HOST=mail.nebendahl.eu
SMTP_PORT=587
# true für Port 465 (TLS), false für STARTTLS auf 587
SMTP_SECURE=false
SMTP_USER=polldeck@nebendahl.eu
SMTP_PASSWORD=
SMTP_FROM="PollDeck <polldeck@nebendahl.eu>"

# --- OIDC / Single Sign-On (optional, z. B. Authentik oder Nextcloud) ---------
# Redirect-URI beim Identity-Provider:  https://APP_DOMAIN/api/auth/oidc/callback
OIDC_ENABLED=false
# z. B. https://auth.nebendahl.eu/application/o/polldeck/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Beschriftung des Login-Buttons
OIDC_LABEL=Authentik
OIDC_SCOPES=openid email profile
# Unbekannte SSO-Benutzer automatisch anlegen
OIDC_AUTO_CREATE=true
# Mitglieder dieser Gruppe (Claim "groups") werden Admin (optional)
OIDC_ADMIN_GROUP=

# --- Limits & Logging --------------------------------------------------------
# Login-Versuche pro Minute und IP
RATE_LIMIT_LOGIN_PER_MIN=10
# Antworten pro Teilnehmer in 10 Sekunden
RATE_LIMIT_VOTES_PER_10S=20
# trace | debug | info | warn | error
LOG_LEVEL=info
