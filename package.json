{
  "name": "polldeck",
  "private": true,
  "version": "1.0.0",
  "description": "PollDeck – selbst gehostete interaktive Präsentations- und Abstimmungsplattform",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter @polldeck/shared build && pnpm -r --filter @polldeck/api --filter @polldeck/web build",
    "dev:api": "pnpm --filter @polldeck/api dev",
    "dev:web": "pnpm --filter @polldeck/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "loadtest": "node scripts/loadtest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "socket.io-client": "4.8.1",
    "typescript": "5.9.3"
  }
}
